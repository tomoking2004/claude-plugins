{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/sync-junctions.ps1\"",
            "timeout": 30,
            "statusMessage": "プラグインのジャンクションを同期中…"
          }
        ]
      }
    ]
  }
}
